+// Pure L2 prefetch: brings a line toward L2 without returning data and without
+// creating a register dependency, so it can be issued for a future tile while
+// the current one is still being consumed. Used to give the sparse KV gather
+// more memory-level parallelism when the cache lives in far (Grace/C2C) memory,
+// where the two-deep shared-memory pipeline cannot cover the load latency.
+__device__ __forceinline__ void prefetch_l2(const void* addr) {
+    asm volatile("prefetch.global.L2 [%0];" :: "l"(addr));
+}
